# Copy to .env and fill in. .env is gitignored.

# OpenRouter API key for LLM chat (not needed when LLM_MOCK=true)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in simulator.
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional: SQLite file location (default: <project root>/db/finally.db; the Docker image sets /app/db/finally.db)
DB_PATH=
